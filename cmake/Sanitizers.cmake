option(SIL_ASAN "Build with AddressSanitizer + UBSan" OFF)
option(SIL_TSAN "Build with ThreadSanitizer" OFF)
if(SIL_ASAN AND SIL_TSAN)
  message(FATAL_ERROR "SIL_ASAN and SIL_TSAN are mutually exclusive")
endif()
if(SIL_ASAN)
  add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer)
  add_link_options(-fsanitize=address,undefined)
endif()
if(SIL_TSAN)
  add_compile_options(-fsanitize=thread -fno-omit-frame-pointer)
  add_link_options(-fsanitize=thread)
endif()
